# .env.example — Copy to .env and fill in your keys

# === LiveKit (Required) ===
# Get from https://cloud.livekit.io
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=your_livekit_api_key
LIVEKIT_API_SECRET=your_livekit_api_secret

# === Deepgram (Required) ===
# Get from https://console.deepgram.com — $200 free credit on signup
DEEPGRAM_API_KEY=your_deepgram_api_key
# DEEPGRAM_MODEL=nova-3                    # Default: nova-3

# === Groq (Required) ===
# Get from https://console.groq.com
GROQ_API_KEY=your_groq_api_key
# GROQ_MODEL=llama-3.3-70b-versatile      # Default. Alt: llama-3.3-70b-specdec

# === Cartesia (Required) ===
# Get from https://cartesia.ai
CARTESIA_API_KEY=your_cartesia_api_key
# CARTESIA_MODEL=sonic-3                   # Default: sonic-3
# CARTESIA_VOICE_ID = a33f7a4c-100f-41cf-a1fd-5822e8fc253f  # Lauren
# Backup voice: # CARTESIA_VOICE_ID=f786b574-daa5-4673-aa0c-cbe3e8534c02  # Katie (warm, stable)
# Run `python scripts/list-voices.py` to browse available voices

# === Avatar Provider (Required) ===
# Options: "simli", "hedra", or "beyondpresence"
AVATAR_PROVIDER=simli

# --- Simli (required if AVATAR_PROVIDER=simli) ---
# Get from https://app.simli.com/apikey — $10 free credit + 50 min/mo
# SIMLI_API_KEY=your_simli_api_key
# SIMLI_FACE_ID=                           # Run `python scripts/list-faces.py` to pick one

# --- Hedra (required if AVATAR_PROVIDER=hedra) ---
# Get from https://www.hedra.com — $0.05/min
HEDRA_API_KEY=your_hedra_api_key
HEDRA_AVATAR_ID=                          # Create at https://www.hedra.com/studio

# === Application (Optional) ===
# LOG_LEVEL=INFO                           # DEBUG, INFO, WARNING, ERROR

# === Database ===
# DATABASE_URL=postgresql://tutor:tutor_dev@localhost:5432/nerdy_tutor
# ARTIFACT_CONTEXT_TURNS=20               # Recent turns fed to artifact generation

# === Frontend → Agent API (Optional) ===
# NEXT_PUBLIC_AGENT_URL=http://localhost:8080

# === Security (Optional — dev mode if unset) ===
# ALLOWED_ORIGIN=http://localhost:3000     # CORS allowed origin for API
# API_SECRET=                              # Shared secret for X-API-Key header auth

# === Vision / Image Generation (Optional) ===
# GROQ_VISION_MODEL=llama-4-scout-17b-16e-instruct
# IMAGE_GEN_PROVIDER=none                 # Options: none, openai, stability
# IMAGE_GEN_API_KEY=
# IMAGE_GEN_MODEL=
