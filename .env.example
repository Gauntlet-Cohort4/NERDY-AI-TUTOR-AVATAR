# .env.example — Copy to .env and fill in your keys

# === LiveKit (Required) ===
# Get from https://cloud.livekit.io
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=your_livekit_api_key
LIVEKIT_API_SECRET=your_livekit_api_secret

# === Deepgram (Required) ===
# Get from https://console.deepgram.com — $200 free credit on signup
DEEPGRAM_API_KEY=your_deepgram_api_key
# DEEPGRAM_MODEL=nova-3                    # Default: nova-3

# === Groq (Required) ===
# Get from https://console.groq.com
GROQ_API_KEY=your_groq_api_key
# GROQ_MODEL=llama-3.3-70b-versatile      # Default. Alt: llama-3.3-70b-specdec

# === Cartesia (Required) ===
# Get from https://cartesia.ai
CARTESIA_API_KEY=your_cartesia_api_key
# CARTESIA_MODEL=sonic-3                   # Default: sonic-3
# CARTESIA_VOICE_ID = a33f7a4c-100f-41cf-a1fd-5822e8fc253f  # Lauren
# Backup voice: # CARTESIA_VOICE_ID=f786b574-daa5-4673-aa0c-cbe3e8534c02  # Katie (warm, stable)
# Run `python scripts/list-voices.py` to browse available voices

# === Simli (Required) ===
# Get from https://app.simli.com/apikey — $10 free credit + 50 min/mo
SIMLI_API_KEY=your_simli_api_key
# SIMLI_FACE_ID=                           # Run `python scripts/list-faces.py` to pick one

# === Application (Optional) ===
# LOG_LEVEL=INFO                           # DEBUG, INFO, WARNING, ERROR
